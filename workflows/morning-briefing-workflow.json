      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [1050, 300]
    },
    {
      "parameters": {
        "model": "llama3.1:8b",
        "prompt": "=You are creating a concise morning briefing. Keep it conversational and brief (maximum 30 seconds when spoken - about 75 words).\n\nWeather: {{ $json.weather_temp }}°C now, high {{ $json.weather_high }}°C, {{ $json.weather_condition }}. {{ $json.weather_precip }}% chance of precipitation.\n\nCalendar: {{ $json.calendar_events || 'No meetings today' }}\n\nSports News:\n{{ $json.sports_news }}\n\nTech News:\n{{ $json.tech_news }}\n\nSmart Home: Bronco at {{ $json.bronco_fuel }}% fuel, {{ $json.bronco_locked === 'locked' ? 'locked' : 'unlocked' }}. Phone at {{ $json.phone_battery }}% battery.\n\nCreate a natural, friendly morning briefing. Format for voice - be conversational, use contractions, no lists or bullets.",
        "options": {
          "temperature": 0.7
        }
      },
      "id": "ollama-generate",
      "name": "Ollama Generate Briefing",
      "type": "@n8n/n8n-nodes-langchain.lmChatOllama",
      "typeVersion": 1,
      "position": [1450, 300]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "telegram-message",
              "name": "telegram_message",
              "value": "=🌅 **Good Morning!**\n\n🌡️ **Weather:** {{ $json.weather_temp }}°C now, high of {{ $json.weather_high }}°C. {{ $json.weather_condition }} with {{ $json.weather_precip }}% chance of precipitation.\n\n📅 **Calendar:** {{ $json.calendar_events || 'No meetings scheduled today' }}\n\n🏈 **Sports:**\n{{ $json.sports_news.split('\\n').map(item => '• ' + item).join('\\n') }}\n\n💻 **Tech:**\n{{ $json.tech_news.split('\\n').map(item => '• ' + item).join('\\n') }}\n\n🏠 **Smart Home:** Bronco at {{ $json.bronco_fuel }}% fuel, {{ $json.bronco_locked === 'locked' ? 'locked' : 'unlocked' }}. Phone at {{ $json.phone_battery }}% battery.\n\nHave a great day! ☕",
              "type": "string"
            },
            {
              "id": "voice-message",
              "name": "voice_message",
              "value": "={{ $('Ollama Generate Briefing').item.json.response }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "format-outputs",
      "name": "Format Outputs",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.2,
      "position": [1650, 300]
    },
    {
      "parameters": {
        "chatId": "6299872789",
        "text": "={{ $json.telegram_message }}",
        "additionalFields": {
          "parse_mode": "Markdown"
        }
      },
      "id": "send-telegram",
      "name": "Send Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.1,
      "position": [1850, 250],
      "credentials": {
        "telegramApi": {
          "id": "telegram-bot-credentials",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "url": "http://homeassistant:8123/api/services/script/announce_morning_briefing",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "message",
              "value": "={{ $json.voice_message }}"
            }
          ]
        },
